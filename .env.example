# Browser (Vite) variables — inlined into the PUBLIC JavaScript bundle at build time.
# Only values that are safe for every visitor to see belong here. Never put a secret key,
# service-role key, database password or AWS credential in a VITE_* variable.
VITE_SUPABASE_URL=https://pwacxxrghlglvdtclbig.supabase.co
# Publishable key (sb_publishable_...) from Project Settings → API Keys. Not the secret key.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Bucket ids are case-sensitive
VITE_SUPABASE_STORAGE_BUCKET=Ps-perfumes-media
VITE_SITE_URL=https://psperfumes.com
# Optional and no longer used for access: admin access is decided by the database (admin_users)
VITE_ADMIN_EMAIL=brandnix.in@gmail.com

# NOT read by the app. Only for scripts/copy-storage-to-new-project.mjs, run on a trusted
# machine with these set in the shell (never in this file, never committed):
#   OLD_SUPABASE_URL, OLD_SUPABASE_SECRET_KEY, NEW_SUPABASE_URL, NEW_SUPABASE_SECRET_KEY
